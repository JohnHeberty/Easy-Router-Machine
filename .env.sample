
# -------------------------------
# 🔧 CONFIGURAÇÃO DE CAMINHOS
# -------------------------------

# Caminho completo para o banco de dados ROUTER (usado pela aplicação).
# ❗ Quando estiver usando o contêiner Docker, este caminho DEVE SER idêntico ao SQLITE_CONTAINER_PATH + nome do arquivo.
# ✅ Em execução local (fora do contêiner), esse caminho deve apontar para o arquivo real no sistema de arquivos do host.
# Exemplo de uso local (Windows):
PATH_DATABASE_ROUTER_SQLITE="db/streets.sqlite"
# Exemplo para uso em contêiner (comente acima e descomente abaixo):
#PATH_DATABASE_ROUTER_SQLITE="/src/infra/db/streets.sqlite"

# Caminho completo para o banco de dados de LOCALIZAÇÕES (usado pela aplicação).
# ❗ Quando estiver usando o contêiner Docker, este caminho DEVE SER idêntico ao SQLITE_CONTAINER_PATH + nome do arquivo.
# ✅ Em execução local (fora do contêiner), esse caminho deve apontar para o arquivo real no sistema de arquivos do host.ste 
# Exemplo de uso local (Windows):
PATH_DATABASE_LOCALES_SQLITE="db/db_locale.sqlite"
# Exemplo para uso em contêiner:
#PATH_DATABASE_LOCALES_SQLITE="/src/infra/db/db_locales.sqlite"

# Caminho da pasta onde os arquivos `.sqlite` devem ser montados DENTRO do contêiner Docker.
# ⚠️ Só é utilizado quando a aplicação roda dentro de contêiner.
SQLITE_CONTAINER_PATH="/src/infra/db/"

# Caminho da pasta onde os arquivos `.sqlite` estão localizados NO HOST (máquina local).
# ⚠️ Só é usado para montagem de volume no Docker Compose.
SQLITE_HOST_PATH="...db/streets/"

# Caminho para os módulos carregáveis do SpatiaLite (diretório, não o arquivo).
# Este caminho é usado para `conn.load_extension(...)` no SQLite.
# Em Windows: deve apontar para a pasta onde estão os `.dll`.
# Em Linux: deve apontar para a pasta onde estão os `.so`.
# ⚠️ OBS: Usar o caminho '/usr/lib/x86_64-linux-gnu/' sempre que for usar container !
PATH_MOD_SPATIALITE=".../loadable-modules/"


# -------------------------------
# ⚙️ CONFIGURAÇÕES DO SISTEMA
# -------------------------------

# Define se o sistema está sendo executado em Windows.
# true = executando localmente em Windows (usa caminhos e DLLs do Windows)
# false = executando em Linux (Docker ou servidor)
WINDOWS_EXECUTE=true


# -------------------------------
# 🚀 CONFIGURAÇÃO DA API
# -------------------------------

# Versão da imagem da API (usada para nomear e versionar o contêiner Docker)
API_ROUTER_VERSION=v0.0.0

# Porta que a API será exposta no host (ex: http://localhost:8015)
API_PORT=0000

# Define se a API deve ser exposta com prefixo (ex: /api/v0 caso seja a versão seja: v0.1.0, /api/v1 caso seja a versão seja: v1.1.0)
API_PREFIX=true

# Usuário da autenticação HTTP Basic (usado para docs e requisições)
API_USER=abcd

# Senha da autenticação HTTP Basic
API_PASS=1234
